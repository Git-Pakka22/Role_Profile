<%
  const statusIcons = {
    draft: 'mdi-content-save-outline', pending_sevak: 'mdi-clock-outline',
    pending_admin: 'mdi-clock-fast', approved: 'mdi-check-circle-outline',
    rejected: 'mdi-close-circle-outline'
  };
  const short = (s, n) => { s = String(s || '').trim(); return s.length > n ? s.slice(0, n) + '…' : s; };
%>
<div class="rp-card">
    <div class="rp-card-header">
        <div class="rp-card-header-left">
            <div class="rp-card-header-icon"><i class="mdi mdi-file-document-edit-outline"></i></div>
            <div>
                <div class="rp-card-title"><%= t("Role Profiles") %></div>
                <div class="rp-card-subtitle"><%= t("Written against a designation, so they outlast any one member") %></div>
            </div>
        </div>
    </div>
    <div class="rp-card-body">
        <% if (canCreate) { %>
            <div class="rp-action-bar">
                <a class="rp-btn-primary" href="/role-profiles/create"><i class="mdi mdi-plus"></i> <%= t("Create Role Profile") %></a>
            </div>
        <% } %>

        <form method="get" class="rp-year-bar">
            <label for="fy"><i class="mdi mdi-calendar-range-outline"></i> <%= t("Financial year") %></label>
            <select name="fy" id="fy" onchange="this.form.submit()">
                <% years.forEach(y => { %>
                    <option value="<%= y.year %>" <%= y.year === chosen ? 'selected' : '' %>><%= y.year %><%= y.is_current ? ' — ' + t('current') : '' %></option>
                <% }) %>
            </select>
            <span class="rp-year-note">
                <i class="mdi mdi-information-outline"></i>
                <%- t.html('Showing where each role profile stands in <strong>{fy}</strong>', { fy: chosen }) %>
                <% if (!fyOpen) { %> <%= t("— this year is closed, so nothing can be reviewed or assessed in it") %><% } %>
            </span>
        </form>

        <% if (dueCount) { %>
            <div class="rp-inbox rp-inbox-due">
                <i class="mdi mdi-calendar-alert"></i>
                <div>
                    <strong><%= t.n('{n} role profile still needs the {fy} review.', '{n} role profiles still need the {fy} review.', dueCount, { fy: chosen }) %></strong><br>
                    <%= t('Confirm it stands as it is, or update it — nobody can be assessed for {fy} until then.', { fy: chosen }) %>
                </div>
            </div>
        <% } %>

        <% if (awaiting.length) { %>
            <div class="rp-inbox">
                <i class="mdi mdi-inbox-arrow-down-outline"></i>
                <div>
                    <strong><%= t.n('{n} role profile waiting on you.', '{n} role profiles waiting on you.', awaiting.length) %></strong><br>
                    <% awaiting.forEach(item => { %>
                        <a href="/role-profiles/<%= item.id %>"><%= item.designation_name %></a>
                        <span style="color:var(--text-muted)"><%= t('from {name}', { name: personName(item.created_by, item.created_by_name) }) %></span><br>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <% if (!profiles.length) { %>
            <div class="rp-empty">
                <i class="mdi mdi-file-document-outline"></i>
                <p>
                    <% if (canCreate) { %>
                        <%= t("No role profiles yet.") %><br><%= t("Create one against a designation your members hold — it stays valid even when people move on.") %>
                    <% } else { %>
                        <%= t("No role profile applies to you yet.") %><br><%= t("One will appear here once your RP Creator writes it and it has been approved.") %>
                    <% } %>
                </p>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="display rp-cards-sm" id="profileTable" style="width:100%">
                    <thead>
                        <tr><th><%= t("Designation") %></th><th><%= t("Sangh") %></th><th><%= t("Created by") %></th><th><%= t("Status") %></th><th><%= chosen %></th><th><%= t("Last updated") %></th><th><%= t("Action") %></th></tr>
                    </thead>
                    <tbody>
                    <% profiles.forEach(p => { const status = p.status; %>
                        <tr>
                            <td>
                                <span class="rp-desig-cell">
                                    <span class="emp-name"><%= p.designation_name %></span>
                                    <% if (String(p.mission || '').trim()) { %><span class="sub"><%= short(tc(p.mission), 70) %></span><% } %>
                                    <% if (p.assigned_names.length) { %><span class="sub rp-assigned"><i class="mdi mdi-account-multiple-outline"></i> <%= p.assigned_names.join(', ') %></span><% } %>
                                </span>
                            </td>
                            <td><span class="emp-sangh"><%= p.sangh_name || '—' %></span><span class="rp-prog rp-prog-<%= p.program === 'ldp' ? 'ldp' : 'psp' %>"><%= p.program === 'ldp' ? 'LDP' : 'PSP' %></span></td>
                            <td>
                                <span class="emp-sangh"><%= personName(p.created_by, p.created_by_name) %></span>
                                <div class="rp-sub"><%= t('created {date}', { date: fmtDate(p.created_at) }) %></div>
                            </td>
                            <td>
                                <span class="rp-status rp-status-<%= status %>">
                                    <i class="mdi <%= statusIcons[status] || 'mdi-help-circle-outline' %>"></i>
                                    <%= statusText(p) %>
                                </span>
                                <% if (status === S.PENDING_SEVAK) { %><div class="rp-sub"><%= t('with {name}', { name: p.rp_approver_name || t('RP Approver') }) %></div>
                                <% } else if (status === S.PENDING_ADMIN) { %><div class="rp-sub"><%= t('with {name}', { name: finalApproverLabel(p) }) %></div>
                                <% } else if (status === S.DRAFT) { %><div class="rp-sub"><%= t("not submitted") %></div>
                                <% } else if (status === S.REJECTED) { %><div class="rp-sub"><%= t("back with author") %></div><% } %>
                            </td>
                            <td>
                                <% if (p.fy_review) { %>
                                    <span class="rp-review-tag <%= p.fy_review.outcome %>">
                                        <i class="mdi <%= p.fy_review.outcome === 'unchanged' ? 'mdi-check' : 'mdi-pencil-outline' %>"></i>
                                        v<%= p.fy_version %> · <%= t(outcomeLabels[p.fy_review.outcome] || p.fy_review.outcome) %>
                                    </span>
                                    <div class="rp-sub">
                                        <%= t.n('{n} assessment', '{n} assessments', p.fy_assessments) %>
                                    </div>
                                <% } else if (p.fy_due) { %>
                                    <span class="rp-review-tag pending"><i class="mdi mdi-calendar-alert"></i> <%= t("Review due") %></span>
                                    <div class="rp-sub"><%= t('would be v{v}', { v: p.fy_would_use }) %></div>
                                <% } else if (p.fy_predates) { %>
                                    <span class="rp-none"><%= t("did not exist yet") %></span>
                                <% } else if (p.fy_would_use && !fyOpen) { %>
                                    <span class="rp-none"><%= t("not reviewed") %></span>
                                    <div class="rp-sub"><%= t("year closed") %></div>
                                <% } else { %>
                                    <span class="rp-none"><%= t("not yet approved") %></span>
                                <% } %>
                            </td>
                            <% const lastChange = p.updated_at || p.created_at; %>
                            <td data-order="<%= lastChange ? new Date(lastChange).getTime() : 0 %>">
                                <span class="emp-sangh"><%= fmtDate(lastChange) %></span>
                                <% if (lastChange) { %><div class="rp-sub"><%= fmtDateTime(lastChange).split(', ').pop() %></div><% } %>
                            </td>
                            <td>
                                <div class="rp-actions">
                                    <a class="rp-edit-btn" href="/role-profiles/<%= p.id %>/view" title="<%= t("View — the role profile sheet") %>" aria-label="<%= t("View") %>"><i class="mdi mdi-eye-outline"></i> <%= t("View") %></a>
                                    <a class="rp-edit-btn" href="/role-profiles/<%= p.id %>" title="<%= t("Details — members, versions, history, approvals") %>" aria-label="<%= t("Details") %>"><i class="mdi mdi-information-outline"></i> <%= t("Details") %></a>
                                    <% if (p.fy_can_review && fyOpen) { %>
                                        <a class="rp-edit-btn rp-edit-btn-due" title="<%= t("Review") %>" href="/role-profiles/<%= p.id %>?tab=versions"><i class="mdi mdi-calendar-check-outline"></i> <%= t('Review {fy}', { fy: chosen }) %></a>
                                    <% } else if (p.is_live && p.created_by === me.code) { %>
                                        <a class="rp-edit-btn" title="<%= t("Assess") %>" aria-label="<%= t("Assess") %>" href="/assessments?fy=<%= encodeURIComponent(chosen) %>&profile=<%= p.id %>"><i class="mdi mdi-clipboard-edit-outline"></i> <%= t("Assess") %></a>
                                    <% } %>
                                    <% if (p.can_update) { %>
                                        <a class="rp-edit-btn" href="/role-profiles/<%= p.id %>/edit" title="<%= t("Update this approved role profile; it goes for approval as a new version") %>"><i class="mdi mdi-file-document-edit-outline"></i> <%= t("Update RP") %></a>
                                    <% } %>
                                    <% if (p.can_edit) { %>
                                        <a class="rp-edit-btn" title="<%= t("Edit") %>" aria-label="<%= t("Edit") %>" href="/role-profiles/<%= p.id %>/edit"><i class="mdi mdi-pencil-outline"></i> <%= t("Edit") %></a>
                                    <% } %>
                                    <% if (canCreate) { %>
                                        <a class="rp-edit-btn" href="/role-profiles/<%= p.id %>/clone" title="<%= t("Start a new role profile from this one") %>"><i class="mdi mdi-content-copy"></i> <%= t("Clone") %></a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<% if (profiles.length) { %>
<script>
$(function () {
    var table = new DataTable('#profileTable', {
        pageLength: 25, order: [[5, 'desc']],
        columnDefs: [{ targets: [6], orderable: false, searchable: false }],
        language: {
            search: '<i class="mdi mdi-magnify"></i>', searchPlaceholder: <%- JSON.stringify(t('Search role profiles or member names...')) %>,
            lengthMenu: <%- JSON.stringify(t('Show _MENU_ entries')) %>, info: <%- JSON.stringify(t('Showing _START_ to _END_ of _TOTAL_ role profiles')) %>,
            zeroRecords: <%- JSON.stringify(t('No role profiles match your search')) %>,
            paginate: { first: '<i class="mdi mdi-chevron-double-left"></i>', last: '<i class="mdi mdi-chevron-double-right"></i>',
                        previous: '<i class="mdi mdi-chevron-left"></i>', next: '<i class="mdi mdi-chevron-right"></i>' }
        }
    });
    // The member list is one line until someone searches, so a name that matched is on show.
    table.on('search.dt', function () { $('#profileTable').toggleClass('rp-searching', !!table.search()); });
});
</script>
<% } %>
