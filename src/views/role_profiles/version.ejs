<%
  const trim2 = (v) => String(Math.round(Number(v) * 100) / 100);
  const fmt = (v) => fmtDateTime(v) || '—';
  // Fold the flat rows back into attributes, the way the details tab shows them.
  const groups = [];
  details.forEach(d => {
    let last = groups[groups.length - 1];
    if (!last || last.no !== d.attribute_no) {
      last = { no: d.attribute_no, name: d.attribute, weight: d.attribute_weight, skills: [] };
      groups.push(last);
    }
    last.skills.push(d);
  });
%>
<a class="rp-back-link" href="/role-profiles/<%= profile.id %>?tab=versions"><i class="mdi mdi-arrow-left"></i> <%= t("All versions") %></a>

<div class="rp-card">
    <div class="rp-card-header">
        <div class="rp-card-header-left">
            <div class="rp-card-header-icon"><i class="mdi mdi-source-branch"></i></div>
            <div>
                <div class="rp-card-title"><%= version.designation_name %></div>
                <div class="rp-card-subtitle">
                    <strong><%= version.sangh_name %></strong> · <%= t('frozen on approval, {date}', { date: fmt(version.approved_at) }) %>
                </div>
            </div>
        </div>
        <div class="rp-header-actions">
            <a class="rp-pdf-btn" href="/role-profiles/<%= profile.id %>/versions/<%= version.id %>/pdf">
                <i class="mdi mdi-file-pdf-box"></i> <%= t("Download PDF") %>
            </a>
            <span class="rp-vchip<%= isLatest ? ' current' : '' %>">v<%= version.version_no %></span>
        </div>
    </div>
    <div class="rp-card-body">

        <div class="rp-frozen-note">
            <i class="mdi mdi-lock-outline"></i>
            <div>
                <%= t('This is version {v} exactly as it was approved — it cannot change.', { v: version.version_no }) %>
                <% if (isLatest) { %><%= t("It is the version in force today.") %>
                <% } else { %><%= t("The role profile has been revised since; this copy is kept so assessments written against it still read correctly.") %><% } %>
            </div>
        </div>

        <div class="rp-applies">
            <div><span class="l"><%= t("Written by") %></span><span class="v"><%= personName(version.created_by, version.created_by_name) %></span></div>
            <% if (version.rp_approver_name) { %>
                <div><span class="l"><%= t("RP Approver") %></span><span class="v"><%= version.rp_approver_name %></span></div>
            <% } %>
            <div><span class="l"><%= t("In force from") %></span><span class="v"><%= version.effective_from_year || '—' %></span></div>
            <div><span class="l"><%= t("Assessments") %></span><span class="v"><%= assessmentCount %></span></div>
        </div>

        <% if (years.length) { %>
            <div class="rp-year-strip">
                <span class="l"><%= t("Financial years this version applies to:") %></span>
                <% years.forEach(y => { %>
                    <span class="rp-year-tag" title="<%= t(outcomeLabels[y.outcome] || y.outcome) %><%= y.reviewed_by_name ? ' — ' + personName(y.reviewed_by, y.reviewed_by_name) : '' %>"><%= y.financial_year %></span>
                <% }) %>
            </div>
        <% } %>

        <% if (changes) { %>
            <div class="rp-section" style="margin-top:18px">
                <h3><i class="mdi mdi-compare-horizontal"></i> <%= t('What changed from version {v}', { v: version.version_no - 1 }) %></h3>
            </div>
            <ul class="rp-change-list">
                <% changes.forEach(c => { %><li><%= c %></li><% }) %>
            </ul>
        <% } %>

        <% if (String(version.mission || '').trim()) { %>
            <div class="rp-section"><h3><i class="mdi mdi-target"></i> <%= t("Mission") %></h3></div>
            <div class="rp-mission"><%= tc(version.mission) %></div>
        <% } %>

        <% const linked = groups.some(g => g.skills.some(sk => sk.outcome_links));
           const otags = (v) => String(v || '').split(',').filter(Boolean); %>
        <% if (outcomes.length) { %>
            <div class="rp-section"><h3><i class="mdi mdi-flag-checkered"></i> <%= t("Key Outcomes") %></h3></div>
            <ul class="rp-outcomes">
                <% outcomes.forEach((o, i) => { %><li><% if (linked) { %><span class="rp-otag">O<%= i + 1 %></span> <% } %><%= tc(o.outcome) %></li><% }) %>
            </ul>
        <% } %>

        <div class="rp-section"><h3><i class="mdi mdi-format-list-checks"></i> <%= t("Technical Skills & Attributes") %></h3></div>
        <% groups.forEach(g => { %>
            <div class="rp-attr">
                <div class="rp-attr-top">
                    <div><div class="rp-attr-name"><%= g.no %>. <%= tc(g.name) %></div></div>
                    <div><span class="rp-weight"><%= trim2(g.weight) %></span></div>
                </div>
                <% g.skills.forEach(sk => { %>
                    <div class="rp-skill">
                        <span><%= tc(sk.tech_skill) %><% otags(sk.outcome_links).forEach(n => { %> <span class="rp-otag" title="<%= outcomes[n - 1] ? tc(outcomes[n - 1].outcome) : '' %>">O<%= n %></span><% }) %></span>
                        <span class="rp-weight-sm"><%= trim2(sk.tech_weight) %></span>
                    </div>
                <% }) %>
                <% const ms = (g.skills.length ? [g.skills[0].measure_1, g.skills[0].measure_2, g.skills[0].measure_3] : []).map((m) => String(m || '').trim());
                   if (ms.some(Boolean)) { const yl = measureLabels(version.measure_from); %>
                    <div class="rp-measures">
                        <div class="rp-measures-title"><i class="mdi mdi-chart-timeline-variant"></i> <%= t("Outcomes Measurability") %></div>
                        <% ms.forEach((m, i) => { %>
                            <div class="rp-measure"><span class="y"><%= yl[i] || '' %></span><span class="m"><%= m ? tc(m) : '—' %></span></div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        <% }) %>
    </div>
</div>
