<%
  const status = profile.status;
  const num = (v) => { const n = Number(v); return Number.isFinite(n) ? String(Math.round(n * 100) / 100) : '—'; };
  const outcomes = (profile.outcomes || []).filter((o) => String(o || '').trim());
  const isLdp = profile.program === 'ldp';
%>
<div class="rps-toolbar">
    <a class="rp-back-link" href="/role-profiles"><i class="mdi mdi-arrow-left"></i> <%= t("All role profiles") %></a>
    <div class="rps-actions">
        <a class="rp-edit-btn" href="/role-profiles/<%= profile.id %>"><i class="mdi mdi-information-outline"></i> <%= t("Details") %></a>
        <% if (status === S.APPROVED) { %>
            <a class="rp-edit-btn" href="/role-profiles/<%= profile.id %>/pdf"><i class="mdi mdi-file-pdf-box"></i> <%= t("Download PDF") %></a>
        <% } %>
        <button type="button" class="rp-edit-btn" onclick="window.print()"><i class="mdi mdi-printer-outline"></i> <%= t("Print") %></button>
    </div>
</div>

<% if (pendingUpdate && inForce) { %>
    <div class="rp-version-banner rps-note">
        <i class="mdi mdi-source-branch"></i>
        <div>
            <%- t.html(status === S.REJECTED
                ? 'This sheet shows the <strong>update that was sent back</strong>. Version {v} is in force for members until it is approved — {link}.'
                : 'This sheet shows the <strong>update awaiting approval</strong>. Version {v} is in force for members until it is approved — {link}.',
                { v: inForce.version_no, link: raw('<a href="/role-profiles/' + profile.id + '/versions/' + inForce.id + '">' + h(t('view version {v}', { v: inForce.version_no })) + '</a>') }) %>
        </div>
    </div>
<% } else if (status !== S.APPROVED) { %>
    <div class="rp-version-banner rps-note">
        <i class="mdi mdi-progress-clock"></i>
        <div><%- t.html('This role profile is <strong>{status}</strong> — it is not in force for anyone yet.', { status: statusText }) %></div>
    </div>
<% } %>

<article class="rps-sheet">
    <header class="rps-band">
        <img src="/img/pakka-logo.png" alt="Pakka" class="rps-logo">
        <div class="rps-band-text">
            <div class="rps-kicker"><%= t("Role Profile") %></div>
            <h1><%= profile.designation_name %></h1>
        </div>
        <span class="rps-status rps-status-<%= status %>"><%= statusText %></span>
    </header>

    <dl class="rps-chips">
        <div><dt><%= t("Sangh") %></dt><dd><%= profile.sangh_name || profile.sangh_code || '—' %></dd></div>
        <div><dt><%= t("Programme") %></dt><dd><%= isLdp ? 'LDP' : 'PSP' %></dd></div>
        <div><dt><%= t("Written by") %></dt><dd><%= personName(profile.created_by, profile.created_by_name) %></dd></div>
        <div><dt><%= t("RP Approver") %></dt><dd><%= profile.rp_approver_code ? personName(profile.rp_approver_code, profile.rp_approver_name) + (profile.rp_approver_action_at ? ' · ' + fmtDate(profile.rp_approver_action_at) : '') : t('Not required') %></dd></div>
        <div><dt><%= finalBy %></dt><dd><%= profile.admin_action_at ? fmtDate(profile.admin_action_at) : t('Pending') %></dd></div>
        <div><dt><%= t("Version") %></dt><dd><%= inForce ? (pendingUpdate ? t('v{v} in force', { v: inForce.version_no }) : 'v' + inForce.version_no) : t('Not yet approved') %></dd></div>
        <div><dt><%= t("Last updated") %></dt><dd><%= fmtDate(profile.updated_at || profile.created_at) %></dd></div>
    </dl>

    <section class="rps-panel">
        <h2 class="rps-panel-title rps-maroon"><%= t("Mission") %></h2>
        <p class="rps-mission"><%= String(profile.mission || '').trim() ? tc(profile.mission) : '—' %></p>
    </section>

    <section class="rps-panel">
        <h2 class="rps-panel-title rps-blue"><%= t("Key Outcomes") %></h2>
        <% if (!outcomes.length) { %>
            <p class="rps-empty"><%= t("No key outcomes written yet.") %></p>
        <% } else { %>
            <ol class="rps-outcomes">
                <% outcomes.forEach((o) => { %><li><%= tc(o) %></li><% }) %>
            </ol>
        <% } %>
    </section>

    <div class="rps-tablewrap">
        <table class="rps-table">
            <% const years = measureLabels(profile.measure_from);
               const cols = 5 + (hasMechanism ? 1 : 0) + (hasMeasures ? 3 : 0);
               const rs = hasMeasures ? ' rowspan="2"' : ''; %>
            <thead>
                <tr>
                    <th class="c"<%- rs %>><%= t("SN") %></th>
                    <th<%- rs %>><%= t("Technical Skills") %></th>
                    <th<%- rs %>><%= t("Attribute") %></th>
                    <% if (hasMeasures) { %><th class="c" colspan="3"><%= t("Outcomes Measurability") %> (<%= measureSpan(profile.measure_from) %>)</th><% } %>
                    <th class="c"<%- rs %>><%= t("Weightage") %></th>
                    <th class="c"<%- rs %>><%= t("Sub-Weightage") %></th>
                    <% if (hasMechanism) { %><th<%- rs %>><%= t("Assessment Mechanism") %></th><% } %>
                </tr>
                <% if (hasMeasures) { %>
                    <tr><% years.forEach(y => { %><th class="c"><%= y %></th><% }) %></tr>
                <% } %>
            </thead>
            <tbody>
            <% if (!attributes.length) { %>
                <tr><td colspan="<%= cols %>" class="rps-empty"><%= t("No skills written yet.") %></td></tr>
            <% } %>
            <% attributes.forEach((a, i) => {
                 const skills = a.skills.length ? a.skills : [{ tech_skill: '', tech_weight: null }];
                 const span = skills.length; %>
                <% skills.forEach((k, j) => { %>
                    <tr class="<%= j === 0 ? 'rps-first' : '' %>">
                        <% if (j === 0) { %>
                            <td class="c rps-sn" rowspan="<%= span %>"><%= i + 1 %></td>
                            <td class="rps-skill" rowspan="<%= span %>"><%= tc(a.attribute) %></td>
                        <% } %>
                        <td><%= k.tech_skill ? tc(k.tech_skill) : '—' %></td>
                        <% if (hasMeasures && j === 0) { (a.measures || ['', '', '']).forEach(m => { %>
                            <td class="rps-measure" rowspan="<%= span %>"><%= String(m || '').trim() ? tc(m) : '—' %></td>
                        <% }) } %>
                        <% if (j === 0) { %>
                            <td class="c rps-weight" rowspan="<%= span %>"><%= num(a.attribute_weight) %></td>
                        <% } %>
                        <td class="c"><%= k.tech_weight == null || k.tech_weight === '' ? '—' : num(k.tech_weight) %></td>
                        <% if (hasMechanism && j === 0) { %>
                            <td rowspan="<%= span %>"><%= a.assessment ? tc(a.assessment) : '—' %></td>
                        <% } %>
                    </tr>
                <% }) %>
            <% }) %>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="<%= hasMeasures ? 6 : 3 %>"><%= t("Total") %></td>
                    <td class="c"><%= num(totalWeight) %></td>
                    <td class="c"><%= num(subTotal) %></td>
                    <% if (hasMechanism) { %><td></td><% } %>
                </tr>
            </tfoot>
        </table>
    </div>
</article>
