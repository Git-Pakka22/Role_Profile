<%
  const covPct = coverage.designations ? Math.round(coverage.created / coverage.designations * 100) : 0;
  const notCreated = coverage.designations - coverage.created;
  const assessPct = membersOnProfiles ? Math.round(assessed / membersOnProfiles * 100) : 0;
  const approved = stages.approved || 0;
  // Donut geometry: one ring, a 2px gap between segments, total in the middle.
  const R = 62, C = 2 * Math.PI * R;
  let offset = 0;
  const segs = stagesList.map((s) => ({ ...s, n: stages[s.key] || 0 })).filter((s) => s.n > 0).map((s) => {
    const len = (s.n / Math.max(total, 1)) * C;
    const seg = { ...s, dash: Math.max(len - 2, 1), offset };
    offset += len;
    return seg;
  });
  const topSanghs = sanghCoverage.slice(0, 8);
%>
<div class="db">

  <!-- ------------------------------------------------------------ hero -->
  <section class="db-hero">
    <div class="db-hero-text">
      <div class="db-kicker"><%= fy %> · <%= t(scopeNote) %></div>
      <h1><%= t('{greeting}, {name}', { greeting: t(greeting), name: me.name || me.code }) %></h1>
      <p>
        <% if (awaiting.length) { %><%- t.html(awaiting.length === 1 ? '<strong>{n}</strong> role profile is waiting for your approval.' : '<strong>{n}</strong> role profiles are waiting for your approval.', { n: awaiting.length }) %> <% } %>
        <%- t.html('<strong>{pct}%</strong> of designations have a role profile so far.', { pct: covPct }) %>
      </p>
    </div>
    <div class="db-hero-actions">
      <a class="db-btn primary" href="/role-profiles/create"><i class="mdi mdi-plus"></i> <%= t("Create Role Profile") %></a>
      <a class="db-btn" href="/reports/role-profiles"><i class="mdi mdi-chart-box-outline"></i> <%= t("Reports") %></a>
      <a class="db-btn" href="/designations"><i class="mdi mdi-badge-account-outline"></i> <%= t("Designations") %></a>
    </div>
  </section>

  <!-- ------------------------------------------------------------ KPIs -->
  <section class="db-kpis">
    <a class="db-kpi" href="/reports/role-profiles">
      <span class="db-kpi-ic maroon"><i class="mdi mdi-file-document-multiple-outline"></i></span>
      <span class="db-kpi-n"><%= total %></span>
      <span class="db-kpi-l"><%= t("Role profiles") %></span>
    </a>
    <a class="db-kpi" href="/reports/role-profiles?stage=approved">
      <span class="db-kpi-ic green"><i class="mdi mdi-check-decagram-outline"></i></span>
      <span class="db-kpi-n"><%= approved %></span>
      <span class="db-kpi-l"><%= t("Approved") %></span>
    </a>
    <a class="db-kpi" href="/reports/role-profiles?stage=pending_admin">
      <span class="db-kpi-ic blue"><i class="mdi mdi-progress-clock"></i></span>
      <span class="db-kpi-n"><%= inApproval %></span>
      <span class="db-kpi-l"><%= t("In approval") %></span>
    </a>
    <a class="db-kpi" href="/reports/role-profiles#missing">
      <span class="db-kpi-ic yellow"><i class="mdi mdi-file-alert-outline"></i></span>
      <span class="db-kpi-n"><%= notCreated %></span>
      <span class="db-kpi-l"><%= t("Designations without an RP") %></span>
    </a>
    <a class="db-kpi" href="/assessments">
      <span class="db-kpi-ic maroon"><i class="mdi mdi-clipboard-check-outline"></i></span>
      <span class="db-kpi-n"><%= assessed %><small> / <%= membersOnProfiles %></small></span>
      <span class="db-kpi-l"><%= t('Assessed in {fy}', { fy }) %></span>
    </a>
  </section>

  <!-- ------------------------------------------------------------ charts -->
  <section class="db-row">
    <div class="db-card">
      <div class="db-card-head"><h2><%= t("Role profiles by stage") %></h2><a href="/reports/role-profiles"><%= t("Open report") %> <i class="mdi mdi-arrow-right"></i></a></div>
      <div class="db-donut-wrap">
        <svg class="db-donut" viewBox="0 0 160 160" role="img" aria-label="<%= t("Role profiles by stage") %>">
          <circle cx="80" cy="80" r="<%= R %>" class="db-donut-track"/>
          <% segs.forEach((s) => { %>
            <circle cx="80" cy="80" r="<%= R %>" class="db-donut-seg rp-rep-<%= s.key %>"
                    stroke-dasharray="<%= s.dash.toFixed(2) %> <%= (C - s.dash).toFixed(2) %>"
                    stroke-dashoffset="<%= (-s.offset).toFixed(2) %>"><title><%= t(s.label) %>: <%= s.n %></title></circle>
          <% }) %>
          <text x="80" y="78" class="db-donut-n"><%= total %></text>
          <text x="80" y="98" class="db-donut-l"><%= t("role profiles") %></text>
        </svg>
        <ul class="db-legend">
          <% stagesList.forEach((s) => { const n = stages[s.key] || 0; %>
            <li class="rp-rep-<%= s.key %>">
              <a href="/reports/role-profiles?stage=<%= s.key %>"><i class="dot"></i><span><%= t(s.label) %></span><b><%= n %></b></a>
            </li>
          <% }) %>
          <% if (stages.update_pending) { %>
            <li class="rp-rep-update_pending"><a href="/reports/role-profiles?stage=update_pending"><i class="dot"></i><span><%= t("Update awaiting approval") %></span><b><%= stages.update_pending %></b></a></li>
          <% } %>
        </ul>
      </div>
    </div>

    <div class="db-card">
      <div class="db-card-head"><h2><%= t("Coverage by sangh") %></h2><a href="/reports/role-profiles#missing"><%= t("What's missing") %> <i class="mdi mdi-arrow-right"></i></a></div>
      <div class="db-cov-sum">
        <span class="db-cov-pct"><%= covPct %>%</span>
        <span><%= t('{created} of {total} designations across {sanghs} sanghs have a role profile', { created: coverage.created, total: coverage.designations, sanghs: coverage.sanghs }) %></span>
      </div>
      <% if (!topSanghs.length) { %>
        <p class="db-empty"><%= t("No designations in your sanghs yet.") %></p>
      <% } else { %>
      <ul class="db-bars">
        <% topSanghs.forEach((g) => { const p = Math.round(g.created / g.total * 100); %>
          <li>
            <a href="/reports/role-profiles?sangh=<%= encodeURIComponent(g.code) %>" title="<%= g.name %>: <%= t('{created} of {total} designations have a role profile', { created: g.created, total: g.total }) %>">
              <span class="db-bar-name"><%= g.name %> <span class="rp-prog rp-prog-<%= g.program %>" style="margin-left:4px"><%= g.program === 'ldp' ? 'LDP' : 'PSP' %></span></span>
              <span class="db-bar"><span class="fill" style="width:<%= p %>%"></span></span>
              <span class="db-bar-v"><b><%= g.created %></b> / <%= g.total %></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <div class="db-legend-inline"><span><i class="dot green"></i><%= t("RP created") %></span><span><i class="dot sand"></i><%= t("Not created yet") %></span></div>
      <% } %>
    </div>
  </section>

  <section class="db-row three">
    <div class="db-card">
      <div class="db-card-head"><h2><%= t("Waiting for you") %></h2><% if (awaiting.length) { %><span class="db-badge"><%= awaiting.length %></span><% } %></div>
      <% if (!awaiting.length) { %>
        <div class="db-empty"><i class="mdi mdi-check-all"></i> <%= t("Nothing is waiting for your approval.") %></div>
      <% } else { %>
        <ul class="db-list">
          <% awaiting.slice(0, 5).forEach((p) => { %>
            <li><a href="/role-profiles/<%= p.id %>">
              <span class="db-list-main"><b><%= p.designation_name %></b><small><%= p.sangh_name %> · <%= t('from {name}', { name: personName(p.created_by, p.created_by_name) }) %></small></span>
              <span class="db-go"><%= t("Review") %> <i class="mdi mdi-arrow-right"></i></span>
            </a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="db-card">
      <div class="db-card-head"><h2><%= t('Assessments {fy}', { fy }) %></h2><a href="/assessments"><%= t("Open") %> <i class="mdi mdi-arrow-right"></i></a></div>
      <div class="db-progress">
        <div class="db-progress-n"><%= assessPct %>%</div>
        <div class="db-progress-bar"><span style="width:<%= assessPct %>%"></span></div>
        <div class="db-progress-l"><%- t.html('<b>{done}</b> of {total} assigned members assessed · <b>{left}</b> to go', { done: assessed, total: membersOnProfiles, left: Math.max(membersOnProfiles - assessed, 0) }) %></div>
      </div>
    </div>

    <div class="db-card">
      <div class="db-card-head"><h2><%= t("By programme") %></h2></div>
      <% if (!byProgram.length) { %>
        <p class="db-empty"><%= t("No role profiles yet.") %></p>
      <% } else { %>
        <% byProgram.forEach((x) => { const p = x.total ? Math.round(x.approved / x.total * 100) : 0; %>
          <div class="db-prog">
            <div class="db-prog-head"><span class="rp-prog rp-prog-<%= x.program %>" style="margin-left:0"><%= x.program === 'ldp' ? 'LDP' : 'PSP' %></span>
              <span><%- t.html(x.total === 1 ? '<b>{n}</b> role profile · <b>{approved}</b> approved' : '<b>{n}</b> role profiles · <b>{approved}</b> approved', { n: x.total, approved: x.approved }) %></span></div>
            <div class="db-progress-bar thin"><span style="width:<%= p %>%"></span></div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <section class="db-row">
    <div class="db-card">
      <div class="db-card-head"><h2><%= t("Recently updated") %></h2><a href="/role-profiles"><%= t("All role profiles") %> <i class="mdi mdi-arrow-right"></i></a></div>
      <% if (!recent.length) { %>
        <p class="db-empty"><%= t("No role profiles yet.") %></p>
      <% } else { %>
        <ul class="db-list">
          <% recent.forEach((p) => { %>
            <li><a href="/role-profiles/<%= p.id %>/view">
              <span class="db-list-main"><b><%= p.designation_name %></b><small><%= p.sangh_name %> · <%= t('updated {date}', { date: fmtDate(p.updated_at || p.created_at) }) %></small></span>
              <span class="rp-status rp-status-<%= p.status %>"><%= statusText(p) %></span>
            </a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="db-card">
      <div class="db-card-head"><h2><%= t("Recent activity") %></h2></div>
      <% if (!activity.length) { %>
        <p class="db-empty"><%= t("No activity yet.") %></p>
      <% } else { %>
        <ul class="db-feed">
          <% activity.forEach((ev) => { const meta = historyMeta[ev.action] || [ev.action, 'mdi-circle-small', 'muted']; %>
            <li>
              <span class="db-feed-ic <%= meta[2] %>"><i class="mdi <%= meta[1] %>"></i></span>
              <span class="db-feed-text">
                <span><b><%= t(meta[0]) %></b> · <a href="/role-profiles/<%= ev.role_profile_id %>"><%= ev.designation_name %></a></span>
                <small><%= t('by {name}', { name: personName(ev.actor_code, ev.actor_name) }) %> · <%= fmtDateTime(ev.created_at) %></small>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </section>
</div>
